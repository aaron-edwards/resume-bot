// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders the whole about page, including the architecture diagram 1`] = `
<div>
  <div
    class="flex flex-col flex-1 overflow-y-auto max-w-2xl w-full mx-auto p-4 gap-6"
  >
    <a
      class="flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors self-start"
      data-discover="true"
      href="/"
    >
      <svg
        aria-hidden="true"
        class="lucide lucide-arrow-left h-4 w-4"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="m12 19-7-7 7-7"
        />
        <path
          d="M19 12H5"
        />
      </svg>
      Back to chat
    </a>
    <section
      class="flex flex-col gap-2"
    >
      <h2
        class="text-base font-semibold"
      >
        What is this thing?
      </h2>
      <div
        class="text-sm text-muted-foreground flex flex-col gap-2"
      >
        <p>
          Nobody actually reads resumes cover to cover, so Aaron built one you can interrogate instead. Ask it whatever you'd normally ask a candidate — it'll answer in real time, grounded in his actual work history, and (mostly) won't make anything up.
        </p>
        <p>
          Is it useful? Probably not.
          <br />
          Was it fun to make? Yes, yes it was.
        </p>
      </div>
    </section>
    <section
      class="flex flex-col gap-2"
    >
      <h2
        class="text-base font-semibold"
      >
        How it works
      </h2>
      <div
        class="text-sm text-muted-foreground flex flex-col gap-2"
      >
        <p>
          Aaron's resume gets shoved into Google's Gemini 2.5 Flash as a system prompt, then the model is told, sternly, to stick to the facts and not wander off into being a general-purpose chatbot.
        </p>
        <ol
          class="list-decimal list-inside flex flex-col gap-1"
        >
          <li>
            Your browser opens a session and grabs any history you left behind
          </li>
          <li>
            Your question hits the API, which streams the model's answer back word by word
          </li>
          <li>
            That answer renders live as markdown, typing-indicator and all
          </li>
          <li>
            The whole conversation gets saved, so you can walk away and pick it back up
          </li>
        </ol>
      </div>
    </section>
    <section
      class="flex flex-col gap-2"
    >
      <h2
        class="text-base font-semibold"
      >
        Architecture (the fun kind)
      </h2>
      <div
        class="text-sm text-muted-foreground flex flex-col gap-2"
      >
        <p>
          A tidy little monorepo, three parts pretending to be one app:
        </p>
        <ul
          class="list-disc list-inside flex flex-col gap-1"
        >
          <li>
            <span
              class="font-medium text-foreground"
            >
              apps/web
            </span>
             — the chat UI you're looking at, living on Firebase Hosting
          </li>
          <li>
            <span
              class="font-medium text-foreground"
            >
              apps/api
            </span>
             — the Fastify brain, running on Google Cloud Run
          </li>
          <li>
            <span
              class="font-medium text-foreground"
            >
              packages/types
            </span>
             — the shared TypeScript contract keeping the other two honest
          </li>
          <li>
            <span
              class="font-medium text-foreground"
            >
              packages/ui
            </span>
             — the shared, Shadcn-flavoured components
          </li>
        </ul>
        <p>
          A cookie remembers who you are and Firestore remembers what you said, so no login and no amnesia between visits.
        </p>
      </div>
    </section>
    <section
      class="flex flex-col gap-2"
    >
